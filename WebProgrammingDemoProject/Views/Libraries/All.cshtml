@model IEnumerable<LibraryViewModel>

@{
    this.ViewData["Title"] = "Libraries List";
}

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Address</th>
            <th scope="col">City</th>
            <th scope="col">Established Year</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var library in this.Model)
        {
            <tr>
                <td>@library.Id</td>
                <td>@library.Name</td>
                <td>@library.Address</td>
                <td>@library.City</td>
                <td>@library.EstablishedYear</td>
            </tr>
        }
    </tbody>
</table>