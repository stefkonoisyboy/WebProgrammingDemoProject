@model EditLibraryInputModel

@{
    this.ViewData["Title"] = "Edit Library Page";
}

<h1 class="text-center">Edit Library</h1>

<form method="post" asp-controller="Libraries" asp-action="Edit" asp-route-id="@this.Model.Id">
    <div asp-validation-summary="All" class="alert-danger"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span asp-validation-for="Name" class="alert-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address"></label>
        <input class="form-control" asp-for="Address" />
        <span asp-validation-for="Address" class="alert-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="City"></label>
        <input class="form-control" asp-for="City" />
        <span asp-validation-for="City" class="alert-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EstablishedYear"></label>
        <input class="form-control" asp-for="EstablishedYear" type="number" />
        <span asp-validation-for="EstablishedYear" class="alert-danger"></span>
    </div>

    <input type="hidden" asp-for="Id" />

    <input type="submit" value="Edit" class="btn btn-primary mt-3" />
</form>